# Plantilla únicamente. No cargar ni versionar secretos reales.
# Genera valores propios con scripts/prepare-local.ps1 o estos comandos:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
JWT_SECRET_BASE64=REEMPLAZAR_POR_32_BYTES_ALEATORIOS_EN_BASE64
JWT_ISSUER=backend-auth-tls
JWT_EXPIRATION_SECONDS=900
DEMO_USER_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_LOCAL
DEMO_ADMIN_PASSWORD=REEMPLAZAR_POR_OTRA_CONTRASENA_LOCAL
TLS_KEYSTORE_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_LOCAL
TLS_KEYSTORE=file:./certs/localhost.p12
SERVER_PORT=8443
CORS_ALLOWED_ORIGIN=http://localhost:4200
